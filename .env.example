# DSN string
DATABASE_URL="postgres+asyncpg://user:password@host:port/database"
TEST_DB="postgres+asyncpg://user:password@host:port/test_database"

# The key for JWT tokens encoding
SECRET_KEY="Your_secret_key"

# JWT token creation settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_DAYS=15
ALGORITHM="HS256"

TMDB_API="Your_TMDB_API"
TMDB_URL="https://api.themoviedb.org"